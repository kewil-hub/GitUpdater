<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">




    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Gist Key Updater" android:textSize="20sp" android:textStyle="bold" />
            <Button android:id="@+id/btnToggleSettings" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Settings" />
        </LinearLayout>

        <LinearLayout android:id="@+id/layoutSettings" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="#F5F5F5" android:padding="12dp" android:layout_marginBottom="16dp">
            <EditText android:id="@+id/etToken" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="GitHub Token" android:inputType="textPassword" android:singleLine="true" />
            <EditText android:id="@+id/etGistId" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Gist ID" android:singleLine="true" />
            <EditText android:id="@+id/etFileName" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Filename (e.g. key.json)" android:singleLine="true" />
            <Button android:id="@+id/btnSaveSettings" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Save Config" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
            <EditText android:id="@+id/etDeviceId" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="Device ID" android:singleLine="true" />
            <Button android:id="@+id/btnPaste" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Paste" android:layout_marginStart="8dp" />
        </LinearLayout>

        <EditText android:id="@+id/etNote" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Buyer Name / Note" android:singleLine="true" android:layout_marginBottom="12dp" />

        <RadioGroup android:id="@+id/rgDuration" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="16dp">
            <RadioButton android:id="@+id/rb7Days" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="7 Days" android:checked="true" android:layout_marginEnd="8dp" />
            <RadioButton android:id="@+id/rb30Days" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="30 Days" android:layout_marginEnd="8dp" />
            <RadioButton android:id="@+id/rbLifetime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lifetime" />
        </RadioGroup>

        <Button android:id="@+id/btnGeneratePush" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Generate Key &amp; Push to Gist" android:layout_marginBottom="12dp" />

        <TextView android:id="@+id/tvStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ready." android:padding="12dp" android:background="#EEEEEE" android:layout_marginBottom="16dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Saved Keys (Tap to Edit)" android:textSize="16sp" android:textStyle="bold" />
            <Button android:id="@+id/btnRefresh" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Refresh" />
        </LinearLayout>

        <LinearLayout android:id="@+id/layoutKeyList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
